# Development Dockerfile with hot reload support
FROM ghcr.io/astral-sh/uv:python3.12-bookworm-slim

WORKDIR /app

# Install system dependencies for geospatial packages and OpenCV
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    curl \
    libgdal-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy dependency files
COPY pyproject.toml uv.lock ./

# Install dependencies including dev dependencies with increased timeout
ARG UV_DEFAULT_INDEX=https://pypi.org/simple
ENV UV_DEFAULT_INDEX=${UV_DEFAULT_INDEX}
ENV UV_HTTP_TIMEOUT=120
# Export pins and hashes so alternate indexes do not reuse public URLs in uv.lock.
RUN uv export --frozen --no-emit-project --format requirements-txt --output-file /tmp/requirements.txt \
    && uv venv \
    && uv pip sync --require-hashes /tmp/requirements.txt \
    && rm /tmp/requirements.txt

# Copy application code (source will be mounted as volume in dev)
COPY . .

# Create directories for config and logs
RUN mkdir -p /app/config /app/logs

# Add .venv to PATH
ENV PATH="/app/.venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1

# Expose port
EXPOSE 8000

# Default command - can be overridden in docker-compose
CMD uvicorn src.main:app --host 0.0.0.0 --port 8000 --reload --log-level debug
